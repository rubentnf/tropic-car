---
import Base from "../../layouts/Base.astro";
import TarjetaFlota from "../../components/TarjetaFlota.astro";
import tarifas from "../../data/tarifas.json";
import { getContenido } from "../../i18n/contenido";
import { locales, localizedPath, type Locale } from "../../i18n/utils";
import type { Tarifas } from "../../lib/tipos";

export function getStaticPaths() {
    return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const f = getContenido(lang).flota;
const data = tarifas as unknown as Tarifas;
---

<Base lang={lang} ruta="flota" title={`${f.titulo} · Tropic Rent a Car`}>
    <div class="contenedor pagina">
        <h1>{f.titulo}</h1>
        <p class="seccion-lead">{f.intro}</p>

        <div class="rejilla-flota">
            {
                data.groups.map((grupo) => (
                    <TarjetaFlota lang={lang} grupo={grupo} detalle nivel={2} />
                ))
            }
        </div>

        <div class="flota-cierre">
            <p class="nota">{f.nota}</p>
            <a class="boton" href={`${localizedPath(lang)}#buscador`}
                >{f.reservar}</a
            >
        </div>
    </div>
</Base>
