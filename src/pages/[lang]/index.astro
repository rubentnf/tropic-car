---
import Base from "../../layouts/Base.astro";
import Buscador from "../../components/Buscador.astro";
import PasosReserva from "../../components/PasosReserva.astro";
import Ventajas from "../../components/Ventajas.astro";
import {
    getDictionary,
    locales,
    localizedPath,
    type Locale,
} from "../../i18n/utils";

export function getStaticPaths() {
    return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);
---

<Base lang={lang}>
    <section class="hero">
        <div class="contenedor">
            <div>
                <h1>{t.hero.title}</h1>
                <p class="hero-lead">{t.hero.lead}</p>
                <ul class="puntos">
                    {t.hero.points.map((punto) => <li>{punto}</li>)}
                </ul>
            </div>
            <Buscador lang={lang} />
        </div>
    </section>

    <Ventajas lang={lang} />

    <section class="seccion" aria-labelledby="titulo-flota">
        <div class="contenedor">
            <div class="seccion-cabecera">
                <div>
                    <h2 id="titulo-flota">{t.home.fleetTitle}</h2>
                    <p class="seccion-lead">{t.home.fleetLead}</p>
                </div>
                <a class="boton" href={localizedPath(lang, "flota")}
                    >{t.home.allGroups}</a
                >
            </div>
        </div>
    </section>

    <PasosReserva lang={lang} />
</Base>
