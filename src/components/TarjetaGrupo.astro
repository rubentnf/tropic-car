---
import GaleriaGrupo from "./GaleriaGrupo.astro";
import { getDictionary, type Locale } from "../i18n/utils";
import { getContenido } from "../i18n/contenido";
import { categoriaGrupo, plazasGrupo } from "../lib/filtros";
import { formatearEuros } from "../lib/formato";
import type { Grupo, Tramo } from "../lib/tipos";

interface Props {
  lang: Locale;
  grupo: Grupo;
}
const { lang, grupo } = Astro.props;
const r = getDictionary(lang).results;

const modelos = grupo.models.map((m) => m.name).join(" · ");
const plazas = grupo.models
  .map((m) => m.pax)
  .find((p) => p !== null && p !== undefined && String(p).trim() !== "");

const tramosTexto = getContenido(lang).flota.tramos;
const tramos: Tramo[] = ["1", "2-3", "4-6", "7+"];
---

<article
  class="tarjeta"
  data-grupo={grupo.id}
  data-cambio={grupo.gearbox}
  data-categoria={categoriaGrupo(grupo)}
  data-plazas={plazasGrupo(grupo)}
>
  <GaleriaGrupo
    lang={lang}
    grupo={grupo}
    sizes="(min-width: 48rem) 12rem, 90vw"
  />
  <div class="tarjeta-info">
    <p class="tarjeta-grupo">
      <span class="insignia">
        {r.group} {grupo.id}
      </span>
    </p>
    <h2>
      {modelos} <small>{r.orSimilar}</small>
    </h2>
    <ul class="etiquetas">
      <li>{r.gearbox[grupo.gearbox]}</li>
      {grupo.air_conditioning && <li>{r.ac}</li>}
      {plazas !== undefined && (
        <li>
          {plazas} {r.seatsLabel}
        </li>
      )}
    </ul>
    <ul class="tramos" aria-label={r.filters.tiers}>
      {tramos.map((tr) => (
        <li data-tramo={tr}>
          <span>{tramosTexto[tr]}</span>
          <strong>
            {grupo.price_per_day_eur[tr] === null
              ? "-"
              : formatearEuros(grupo.price_per_day_eur[tr] as number, lang)}
          </strong>
        </li>
      ))}
    </ul>
  </div>
  <div class="tarjeta-precio">
    <p class="aviso" data-aviso hidden></p>
    <div data-precio hidden>
      <p class="importe-total">
        <span>{r.total}</span>
        <strong data-precio-total></strong>
      </p>
      <p class="importe-dia">
        <strong data-precio-dia></strong>
        {r.perDay}
      </p>
      <p class="nota">{r.taxesIncluded}</p>
    </div>
    <a
      class="boton boton-oscuro"
      data-solicitar
      href="#"
      hidden
      aria-label={`${r.request}: ${r.group} ${grupo.id}`}
    >
      {r.request}
    </a>
  </div>
</article>
