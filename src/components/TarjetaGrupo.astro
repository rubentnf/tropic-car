---
import GaleriaGrupo from "./GaleriaGrupo.astro";
import { getDictionary, type Locale } from "../i18n/utils";
import type { Grupo } from "../lib/tipos";

interface Props {
    lang: Locale;
    grupo: Grupo;
}
const { lang, grupo } = Astro.props;
const r = getDictionary(lang).results;

const modelos = grupo.models.map((m) => m.name).join(" · ");
const plazas = grupo.models
    .map((m) => m.pax)
    .find((p) => typeof p === "number");
---

<article class="tarjeta" data-grupo={grupo.id}>
    <GaleriaGrupo lang={lang} grupo={grupo} />
    <div class="tarjeta-info">
        <p class="tarjeta-grupo">
            <span class="insignia">{r.group} {grupo.id}</span>
        </p>
        <h3>{modelos} <small>{r.orSimilar}</small></h3>
        <ul class="etiquetas">
            <li>{r.gearbox[grupo.gearbox]}</li>
            {grupo.air_conditioning && <li>{r.ac}</li>}
            {
                plazas !== undefined && (
                    <li>
                        {plazas} {r.seatsLabel}
                    </li>
                )
            }
        </ul>
    </div>
    <div class="tarjeta-precio">
        <p class="aviso" data-aviso hidden></p>
        <div data-precio hidden>
            <p class="importe-dia">
                <strong data-precio-dia></strong>
                <span>{r.perDay}</span>
            </p>
            <p class="importe-total">
                {r.total}: <strong data-precio-total></strong>
            </p>
            <p class="nota">{r.taxesIncluded}</p>
        </div>
        <a class="boton boton-oscuro" data-solicitar href="#" hidden
            >{r.request}</a
        >
    </div>
</article>
