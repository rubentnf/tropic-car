---
import "@fontsource-variable/archivo";
import "../styles/global.css";
import { Image } from "astro:assets";
import { PUBLIC_UMAMI_WEBSITE_ID } from "astro:env/client";
import Consentimiento from "../components/Consentimiento.astro";
import logo from "../assets/logo.png";
import { empresa } from "../data/empresa";
import { getContenido } from "../i18n/contenido";
import {
    getDictionary,
    locales,
    localizedPath,
    regiones,
    type Locale,
} from "../i18n/utils";
import { datosEstructurados } from "../lib/seo";

interface Props {
    lang: Locale;
    title?: string;
    description?: string;
    /** Ruta sin idioma, p. ej. "flota". Vacía para la portada. */
    ruta?: string;
    /** Páginas que no deben salir en buscadores (resultados, solicitud, gracias). */
    noindex?: boolean;
}

const { lang, title, description, ruta = "", noindex = false } = Astro.props;
const t = getDictionary(lang);
const pie = getContenido(lang).footer;

const absoluta = (l: Locale) =>
    new URL(localizedPath(l, ruta), Astro.site ?? Astro.url).href;
const textoTitulo = title ?? t.meta.title;
const textoDescripcion = description ?? t.meta.description;
const esPortada = ruta === "";
const pendiente = (valor: string) => valor.includes("PENDIENTE");
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="apple-touch-icon" href="/favicon.png" />
        <title>{textoTitulo}</title>
        <meta name="description" content={textoDescripcion} />
        {noindex && <meta name="robots" content="noindex" />}
        <link rel="canonical" href={absoluta(lang)} />
        {
            locales.map((l) => (
                <link rel="alternate" hreflang={l} href={absoluta(l)} />
            ))
        }
        <link rel="alternate" hreflang="x-default" href={absoluta("es")} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Tropic Rent a Car" />
        <meta property="og:title" content={textoTitulo} />
        <meta property="og:description" content={textoDescripcion} />
        <meta property="og:url" content={absoluta(lang)} />
        <meta property="og:locale" content={regiones[lang].og} />
        {
            esPortada && (
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify(
                        datosEstructurados(absoluta(lang)),
                    )}
                />
            )
        }
    </head>
    <body>
        <a class="boton saltar" href="#contenido">{t.nav.skip}</a>
        <header class="cabecera">
            <div class="contenedor">
                <a
                    class="logo"
                    href={localizedPath(lang)}
                    aria-label="Tropic Rent a Car"
                >
                    <Image
                        src={logo}
                        alt="Tropic Rent a Car"
                        height={112}
                        densities={[1, 2]}
                        loading="eager"
                    />
                </a>
                <nav class="nav" aria-label={t.nav.mainLabel}>
                    <a href={localizedPath(lang, "flota")}>{t.nav.fleet}</a>
                    <a href={`${localizedPath(lang)}#como`}>{t.nav.how}</a>
                    <a href={localizedPath(lang, "contacto")}>{t.nav.contact}</a
                    >
                </nav>
                <div class="idiomas" role="group" aria-label={t.nav.language}>
                    {
                        locales.map((l) => (
                            <a
                                href={localizedPath(l, ruta)}
                                data-idioma
                                hreflang={l}
                                lang={l}
                                aria-current={l === lang ? "true" : undefined}
                            >
                                {l.toUpperCase()}
                            </a>
                        ))
                    }
                </div>
            </div>
        </header>
        <main id="contenido" tabindex="-1"><slot /></main>
        <footer class="pie">
            <div class="contenedor pie-contenido">
                <div class="pie-datos">
                    <strong
                        >© {new Date().getFullYear()} {t.footer.rights}</strong
                    >
                    {
                        !pendiente(empresa.telefono) && (
                            <a
                                href={`tel:${empresa.telefono.replace(/\s/g, "")}`}
                            >
                                {empresa.telefono}
                            </a>
                        )
                    }
                    {
                        !pendiente(empresa.email) && (
                            <a href={`mailto:${empresa.email}`}>
                                {empresa.email}
                            </a>
                        )
                    }
                </div>
                <nav class="pie-enlaces" aria-label={t.footer.legalLabel}>
                    <a href={localizedPath(lang, "aviso-legal")}
                        >{pie.avisoLegal}</a
                    >
                    <a href={localizedPath(lang, "privacidad")}
                        >{pie.privacidad}</a
                    >
                    <a href={localizedPath(lang, "cookies")}>{pie.cookies}</a>
                    {
                        PUBLIC_UMAMI_WEBSITE_ID && (
                            <button
                                type="button"
                                class="enlace"
                                data-configurar-cookies
                            >
                                {pie.configurarCookies}
                            </button>
                        )
                    }
                </nav>
            </div>
        </footer>
        <Consentimiento lang={lang} />
    </body>
</html>

<script>
    // Al cambiar de idioma se conserva la búsqueda (lugares, fechas y coche elegido).
    for (const enlace of document.querySelectorAll<HTMLAnchorElement>(
        "[data-idioma]",
    )) {
        enlace.search = location.search;
    }
</script>
